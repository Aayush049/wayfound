rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTripMember(tripId) {
      return isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds);
    }

    function isTripOrganizer(tripId) {
      return isSignedIn() && (request.auth.uid == get(/databases/$(database)/documents/trips/$(tripId)).data.organizerId);
    }

    function isTripNotArchived(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.archived == false;
    }

    function getVoteBeforeVal(database, tripId, sid, uid) {
      return exists(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid)/votes/$(uid))
        ? get(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid)/votes/$(uid)).data.value
        : 0;
    }

    function getVoteAfterVal(database, tripId, sid, uid) {
      return existsAfter(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid)/votes/$(uid))
        ? getAfter(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid)/votes/$(uid)).data.value
        : 0;
    }

    function getUpDelta(beforeVal, afterVal) {
      return (afterVal == 1 ? 1 : 0) - (beforeVal == 1 ? 1 : 0);
    }

    function getDownDelta(beforeVal, afterVal) {
      return (afterVal == -1 ? 1 : 0) - (beforeVal == -1 ? 1 : 0);
    }

    // Users collection: users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow delete: if false;
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['displayName', 'email', 'createdAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'email', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.photoUrl == null || request.resource.data.photoUrl is string)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoUrl'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 50
        && (request.resource.data.photoUrl == null || request.resource.data.photoUrl is string);
    }

    // Trips collection: trips/{tripId}
    match /trips/{tripId} {
      // Read: signed in and caller is in memberIds
      allow get, list: if isSignedIn() && (request.auth.uid in resource.data.memberIds);

      // Create: exact keys, creator is organizer, memberIds == [auth.uid], memberCount == 1, archived == false, etc.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['name', 'destination', 'startDate', 'endDate', 'currency', 'organizerId', 'joinCode', 'memberIds', 'memberCount', 'archived', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'destination', 'startDate', 'endDate', 'currency', 'organizerId', 'joinCode', 'memberIds', 'memberCount', 'archived', 'createdAt'])
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberCount == 1
        && request.resource.data.archived == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && request.resource.data.destination is string && request.resource.data.destination.size() >= 1 && request.resource.data.destination.size() <= 80
        && request.resource.data.startDate is timestamp && request.resource.data.endDate is timestamp && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.currency in ['INR', 'USD', 'EUR', 'GBP', 'AED', 'AUD', 'CAD', 'SGD', 'JPY', 'CHF']
        && request.resource.data.joinCode is string && request.resource.data.joinCode.matches('^[A-HJKMNP-Z2-9]{6}$')
        && getAfter(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode)).data.tripId == tripId
        && existsAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));

      // Join update (the high-risk rule)
      // Important: guard against missing resource fields during create writes.
      // Without these guards, the emulator can throw an evaluation error when it
      // attempts to evaluate the update rule against a non-existent document.
      allow update: if isSignedIn()
        && resource.data.memberIds is list
        && resource.data.memberCount is number
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.removeAll(resource.data.memberIds) == [request.auth.uid]
        && resource.data.memberIds.size() == resource.data.memberCount
        && request.resource.data.memberIds.size() == request.resource.data.memberCount
        && resource.data.memberCount < 15
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && resource.data.archived == false
        && existsAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));

      allow delete: if false;

      // Subcollection: trips/{tripId}/members/{uid}
      match /members/{uid} {
        allow get, list: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds);

        allow create: if isSignedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasAll(['displayName', 'photoUrl', 'role', 'status', 'joinedAt'])
          && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'role', 'status', 'joinedAt'])
          && request.resource.data.status == 'active'
          && request.resource.data.joinedAt == request.time
          && request.resource.data.displayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && request.resource.data.photoUrl == (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['photoUrl']) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.photoUrl : null)
          && (
            (request.resource.data.role == 'organizer' && getAfter(/databases/$(database)/documents/trips/$(tripId)).data.organizerId == request.auth.uid)
            ||
            (request.resource.data.role == 'member' && !(request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds) && (request.auth.uid in getAfter(/databases/$(database)/documents/trips/$(tripId)).data.memberIds))
          );

        allow update, delete: if false;
      }

      // Subcollection: trips/{tripId}/suggestions/{sid}
      match /suggestions/{sid} {
        allow get, list: if isSignedIn() && isTripMember(tripId);

        allow create: if isSignedIn()
          && isTripMember(tripId)
          && isTripNotArchived(tripId)
          && request.resource.data.keys().hasAll(['title', 'note', 'estimatedCost', 'category', 'authorId', 'upCount', 'downCount', 'status', 'dayIndex', 'order', 'createdAt'])
          && request.resource.data.keys().hasOnly(['title', 'note', 'estimatedCost', 'category', 'authorId', 'upCount', 'downCount', 'status', 'dayIndex', 'order', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.upCount == 0
          && request.resource.data.downCount == 0
          && request.resource.data.status == 'pending'
          && request.resource.data.dayIndex == null
          && request.resource.data.order == null
          && request.resource.data.createdAt == request.time
          && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 80
          && request.resource.data.note is string && request.resource.data.note.size() >= 0 && request.resource.data.note.size() <= 500
          && request.resource.data.category in ['food', 'sightseeing', 'stay', 'transport', 'other']
          && (request.resource.data.estimatedCost == null || (request.resource.data.estimatedCost is int && request.resource.data.estimatedCost >= 0 && request.resource.data.estimatedCost <= 100000000000));

        allow update: if isSignedIn()
          && isTripMember(tripId)
          && isTripNotArchived(tripId)
          && (resource.data.authorId == request.auth.uid || isTripOrganizer(tripId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'note', 'estimatedCost', 'category'])
          && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 80
          && request.resource.data.note is string && request.resource.data.note.size() >= 0 && request.resource.data.note.size() <= 500
          && request.resource.data.category in ['food', 'sightseeing', 'stay', 'transport', 'other']
          && (request.resource.data.estimatedCost == null || (request.resource.data.estimatedCost is int && request.resource.data.estimatedCost >= 0 && request.resource.data.estimatedCost <= 100000000000));

        allow update: if isSignedIn()
          && isTripMember(tripId)
          && isTripNotArchived(tripId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upCount', 'downCount'])
          && request.resource.data.upCount is int && request.resource.data.upCount >= 0
          && request.resource.data.downCount is int && request.resource.data.downCount >= 0
          && getVoteBeforeVal(database, tripId, sid, request.auth.uid) != getVoteAfterVal(database, tripId, sid, request.auth.uid)
          && request.resource.data.upCount == resource.data.upCount + getUpDelta(getVoteBeforeVal(database, tripId, sid, request.auth.uid), getVoteAfterVal(database, tripId, sid, request.auth.uid))
          && request.resource.data.downCount == resource.data.downCount + getDownDelta(getVoteBeforeVal(database, tripId, sid, request.auth.uid), getVoteAfterVal(database, tripId, sid, request.auth.uid));

        allow update: if isSignedIn()
          && isTripMember(tripId)
          && isTripOrganizer(tripId)
          && isTripNotArchived(tripId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dayIndex', 'order'])
          && (
            (request.resource.data.status == 'pending' && request.resource.data.dayIndex == null && request.resource.data.order == null)
            ||
            (
              request.resource.data.status == 'scheduled'
              && request.resource.data.dayIndex is int
              && request.resource.data.dayIndex >= 0
              && request.resource.data.dayIndex <= (get(/databases/$(database)/documents/trips/$(tripId)).data.endDate.toMillis() - get(/databases/$(database)/documents/trips/$(tripId)).data.startDate.toMillis()) / 86400000
              && request.resource.data.order is int
              && request.resource.data.order >= 0
              && request.resource.data.order <= 10000
            )
          );

        allow delete: if isSignedIn()
          && isTripMember(tripId)
          && isTripNotArchived(tripId)
          && (resource.data.authorId == request.auth.uid || isTripOrganizer(tripId));

        match /votes/{uid} {
          allow get, list: if isSignedIn() && uid == request.auth.uid && isTripMember(tripId);

          allow create, update: if isSignedIn()
            && uid == request.auth.uid
            && isTripMember(tripId)
            && isTripNotArchived(tripId)
            && request.resource.data.keys().hasAll(['value', 'updatedAt'])
            && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
            && (request.resource.data.value == 1 || request.resource.data.value == -1)
            && request.resource.data.updatedAt == request.time
            && (request.method == 'create' || request.resource.data.value != resource.data.value)
            && existsAfter(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid))
            && getAfter(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid)).data.upCount == get(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid)).data.upCount + getUpDelta(getVoteBeforeVal(database, tripId, sid, uid), request.resource.data.value)
            && getAfter(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid)).data.downCount == get(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid)).data.downCount + getDownDelta(getVoteBeforeVal(database, tripId, sid, uid), request.resource.data.value);

          allow delete: if isSignedIn()
            && uid == request.auth.uid
            && isTripMember(tripId)
            && isTripNotArchived(tripId)
            && existsAfter(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid))
            && getAfter(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid)).data.upCount == get(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid)).data.upCount + getUpDelta(resource.data.value, 0)
            && getAfter(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid)).data.downCount == get(/databases/$(database)/documents/trips/$(tripId)/suggestions/$(sid)).data.downCount + getDownDelta(resource.data.value, 0);
        }
      }
    }

    // Collection: joinCodes/{code}
    match /joinCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && code.matches('^[A-HJKMNP-Z2-9]{6}$')
        && request.resource.data.keys().hasAll(['tripId', 'tripName', 'destination', 'startDate', 'endDate', 'memberCount'])
        && request.resource.data.keys().hasOnly(['tripId', 'tripName', 'destination', 'startDate', 'endDate', 'memberCount'])
        && request.resource.data.memberCount == 1
        && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.organizerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.name == request.resource.data.tripName
        && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.destination == request.resource.data.destination
        && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.startDate == request.resource.data.startDate
        && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.endDate == request.resource.data.endDate;

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
        && request.resource.data.memberCount == getAfter(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.memberCount;

      allow delete: if false;
    }

    // Baseline deny-all for all other collections
    match /{path=**}/** {
      allow read, write: if false;
    }
  }
}
